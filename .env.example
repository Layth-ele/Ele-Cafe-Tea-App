# ─────────────────────────────────────────────────────────────────────────
# Firebase web app configuration.
#
# Copy this file to `.env` (no extension change — `.env.example` → `.env`)
# and replace each value with your project's actual config.
#
# Where to find these values:
#   1. Open https://console.firebase.google.com
#   2. Select your project
#   3. Click ⚙️ Project Settings → "Your apps" tab
#   4. Click your web app → "SDK setup and configuration" → "Config"
#   5. Copy each value from the firebaseConfig object shown there
#
# Note: these values are PUBLIC by design — they identify your Firebase
# project to the SDK but don't grant any permissions. Real security comes
# from your Firestore rules and Auth provider config. So it's safe to
# embed them in the client bundle. Don't bother encrypting these.
# ─────────────────────────────────────────────────────────────────────────

# Required — build will fail without these
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Required for full functionality (Storage uploads, Cloud Messaging, Analytics)
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Web Push (FCM) — required for OS push notifications (badge + lock-screen alerts).
# Find this in Firebase Console → Project Settings → Cloud Messaging →
# Web configuration → Key pair → Copy the "Key pair" value.
# Without this key, usePushNotifications.ts will not request a push token
# and sendPushToUser in Cloud Functions will find no tokens to send to.
VITE_FIREBASE_VAPID_KEY=
VITE_FIREBASE_MEASUREMENT_ID=

# ─────────────────────────────────────────────────────────────────────────
# Optional — Google reCAPTCHA v3 site key for bot prevention on signup.
# This is for one-shot ACTION verification (e.g. score check on the
# signup form). Get from https://www.google.com/recaptcha/admin/create
# Leave blank to disable reCAPTCHA action verification (signup still
# works, just unprotected against bots).
# ─────────────────────────────────────────────────────────────────────────
VITE_RECAPTCHA_SITE_KEY=

# ─────────────────────────────────────────────────────────────────────────
# Optional but STRONGLY RECOMMENDED — Firebase App Check site key.
#
# This is a SEPARATE reCAPTCHA v3 site key from the one above —
# it's registered through Firebase Console, not Google's reCAPTCHA admin.
# App Check attaches a token to every Firestore / Auth / Storage /
# Functions request, letting Firebase reject traffic from anywhere
# other than your real production domain.
#
# Setup:
#   1. Open Firebase Console → your project
#   2. Build → App Check → Apps tab
#   3. Find your web app → click "Register"
#   4. Choose "reCAPTCHA v3" provider
#   5. Copy the SITE KEY (the long public one — NOT the secret key)
#   6. Paste below
#   7. After deploying, watch the App Check metrics tab — verified
#      requests should climb to ~100% within a few hours
#   8. Once stable, click "Enforce" on each tab (Firestore, Auth,
#      Storage, Functions) to start rejecting unverified traffic
#
# Leave blank to disable App Check entirely (NOT recommended for
# production). With Enforcement on but this key blank, every request
# from your live site will be rejected.
# ─────────────────────────────────────────────────────────────────────────
VITE_FIREBASE_APP_CHECK_KEY=


# ─────────────────────────────────────────────────────────────────────────
# REQUIRED FOR PRODUCTION — Sentry DSN for client-side error reporting.
#
# Phase 0.7.3 gate. Without this, captured exceptions are no-ops and
# you'll be flying blind on runtime errors in production.
#
# Setup:
#   1. Open https://sentry.io (free tier covers up to 5K events/month)
#   2. Create a new project → React platform → name "ele-cafe-web"
#   3. Sentry shows you a DSN. It looks like:
#      https://<32-char-key>@o<orgid>.ingest.sentry.io/<projectid>
#   4. Paste below
#
# Verification: after the next production deploy, the Sentry "Issues"
# tab should show the boot event (a low-severity transaction). If
# not within 30 seconds of first page load, the DSN is wrong or the
# project is paused.
#
# Dev safety: when blank, sentry.ts skips Sentry.init() entirely —
# no warnings, no failures. The captureException calls become no-ops.
# This is deliberate: developers cloning the repo shouldn't need a
# Sentry account just to run the app.
# ─────────────────────────────────────────────────────────────────────────
VITE_SENTRY_DSN=

# ─────────────────────────────────────────────────────────────────────────
# Optional — Sentry release tag override (defaults to git SHA via vite).
# Leave blank in normal use; set explicitly if you need to override
# release attribution for a hotfix or special deploy.
# ─────────────────────────────────────────────────────────────────────────
VITE_SENTRY_RELEASE=

# Optional (dev only): fixed App Check debug token so all local browsers share one registered token
# VITE_APPCHECK_DEBUG_TOKEN=

# ── Card payments (Clover Ecommerce) ─────────────────────────────────
# Public values — safe in the browser bundle. From Clover dashboard →
# Account & Setup → Ecommerce API Tokens (public key = PAKMS apiAccessKey).
# The PRIVATE token is a Cloud Functions secret, never here:
#   firebase functions:secrets:set CLOVER_PRIVATE_TOKEN
# and set CLOVER_ENVIRONMENT=production in functions/.env when going live.
VITE_CLOVER_PUBLIC_KEY=
VITE_CLOVER_MERCHANT_ID=
VITE_CLOVER_ENVIRONMENT=sandbox
