# Phase 0.4 — Playwright auth state files. Generated per-run by
# playwright.setup.ts; contain Firebase ID tokens for the test UIDs.
# Never commit (the tokens are short-lived but still credentials).
/tests/.auth/

# Phase 0.3 — size-limit run output. Per-PR artifact, not source.
/.size-report.json

# Phase 2 — Storybook builds. Generated by `npm run build-storybook`;
# uploaded to Chromatic in CI. Not source.
/storybook-static/

# Local artifacts — Lighthouse reports and throwaway scripts
*.report.html
*.report.json
/.pw-*.mjs
/.tmp-*.cjs
/.x.mjs
