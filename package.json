{
  "name": "ele-cafe",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && cp dist/index.html dist/app.html",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix",
    "prepare": "node -e \"try{require('child_process').execSync('husky',{stdio:'inherit'})}catch(e){console.warn('[prepare] husky skipped:',(e&&e.message)||e)}\"",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:visual:ui": "playwright test --ui",
    "test:a11y": "playwright test --config=playwright.a11y.config.ts",
    "test:a11y:ui": "playwright test --config=playwright.a11y.config.ts --ui",
    "test:a11y:scan": "node scripts/a11y-static-scan.mjs",
    "audit:layout": "node scripts/layout-audit.mjs",
    "test:a11y:reduced-motion": "playwright test --config=playwright.a11y.config.ts tests/a11y/reduced-motion.spec.ts",
    "test:a11y:aria-announcements": "playwright test --config=playwright.a11y.config.ts tests/a11y/aria-announcements.spec.ts",
    "test:a11y:sr-tree": "playwright test --config=playwright.a11y.config.ts tests/a11y/screen-reader-tree.spec.ts",
    "test:a11y:narrow-viewport": "playwright test --config=playwright.a11y.config.ts tests/a11y/narrow-viewport.spec.ts",
    "audit:safe-area": "node scripts/safe-area-audit.mjs",
    "audit:touch-targets": "node scripts/touch-target-audit.mjs",
    "perf:lighthouse-local": "node scripts/local-lighthouse.mjs",
    "test:perf:synthetic": "playwright test --config=playwright.perf.config.ts",
    "verify:observability": "node scripts/verify-observability.mjs",
    "test:seo": "playwright test --config=playwright.seo.config.ts",
    "test:lighthouse": "lhci autorun",
    "test:lighthouse:collect": "lhci collect",
    "test:lighthouse:assert": "lhci assert",
    "lint": "eslint src tests functions/src",
    "lint:fix": "eslint src tests functions/src --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore --project demo-ele-cafe \"vitest run --config vitest.rules.config.ts\"",
    "test:coverage": "vitest run --coverage",
    "size": "size-limit",
    "size:why": "size-limit --why",
    "tokens:export": "node scripts/tokens-export.mjs",
    "tokens:contrast": "node scripts/contrast-check.mjs",
    "tokens:contrast:aaa": "node scripts/contrast-check.mjs --aaa",
    "tokens:oklch:derive": "node scripts/oklch-derive.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "chromatic --exit-zero-on-changes"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.2.11",
    "@fontsource/jost": "^5.2.8",
    "@hookform/resolvers": "^5.2.2",
    "@popperjs/core": "2.11.8",
    "@radix-ui/react-select": "2.1.6",
    "@radix-ui/react-slot": "1.1.2",
    "@sentry/react": "^9.10.0",
    "@tanstack/react-query": "^5.100.11",
    "@tanstack/react-query-devtools": "^5.100.11",
    "@use-gesture/react": "^10.3.1",
    "blurhash": "^2.0.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "3.6.0",
    "firebase": "^11.6.0",
    "firebase-admin": "^13.10.0",
    "immer": "^10.1.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.487.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "7.55.0",
    "react-router": "^7.18.4",
    "sonner": "2.0.3",
    "tailwind-merge": "3.2.0",
    "tw-animate-css": "1.3.8",
    "web-vitals": "^4.2.4",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.60.0",
    "@size-limit/preset-app": "^11.1.6",
    "@storybook/addon-a11y": "^8.4.0",
    "@storybook/addon-essentials": "^8.4.0",
    "@storybook/addon-interactions": "^8.4.0",
    "@storybook/addon-themes": "^8.4.0",
    "@storybook/blocks": "^8.4.0",
    "@storybook/react": "^8.4.0",
    "@storybook/react-vite": "^8.4.0",
    "@storybook/test": "^8.4.0",
    "@tailwindcss/vite": "4.1.12",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "^2.1.9",
    "chromatic": "^11.18.0",
    "culori": "^4.0.2",
    "eslint": "^9.17.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.8.3",
    "puppeteer-core": "^23.11.1",
    "size-limit": "^11.1.6",
    "storybook": "^8.4.0",
    "stylelint": "^16.10.0",
    "stylelint-config-standard": "^37.0.0",
    "stylelint-declaration-strict-value": "^1.10.11",
    "tailwindcss": "4.1.12",
    "typescript": "^5.6.0",
    "vite": "^6.4.2",
    "vite-plugin-pwa": "^0.21.0",
    "vitest": "^2.1.9",
    "workbox-cacheable-response": "^7.4.0",
    "workbox-core": "^7.4.0",
    "workbox-expiration": "^7.4.0",
    "workbox-precaching": "^7.4.0",
    "workbox-routing": "^7.4.0",
    "workbox-strategies": "^7.4.0"
  },
  "pnpm": {
    "overrides": {
      "vite": "^6.4.2",
      "serialize-javascript": "^7.0.5"
    }
  },
  "overrides": {
    "serialize-javascript": "^7.0.5"
  },
  "lint-staged": {
    "src/**/*.css": [
      "stylelint --fix"
    ]
  }
}
